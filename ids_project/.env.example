# =============================================================================
# NetGuard IDS — Environment Configuration Template
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# NOTE: Never commit your production or local .env containing live credentials.
# =============================================================================

# --- Network Sniffing ---
# Interface to sniff on (find yours using: `ip link show` or `ifconfig`)
IDS_INTERFACE=eth0

# --- Network Whitelist / Trusted Hosts ---
# Gateway IP and trusted local infrastructure (router, DNS, local servers)
# These hosts are exempted from scan and flood alerts to prevent false positives.
GATEWAY_IP=192.168.1.1
# Comma-separated list of additional trusted hosts, domain names, or CIDRs:
IDS_TRUSTED=8.8.8.8,1.1.1.1

# --- Storage / Database ---
# Database backend: "sqlite" (zero-configuration default) or "postgres"
DB_BACKEND=sqlite

# SQLite database file path (only used when DB_BACKEND=sqlite)
SQLITE_PATH=storage/alerts.db

# PostgreSQL connection string (only used when DB_BACKEND=postgres)
# POSTGRES_URL=postgresql://ids_user:secure_password@localhost:5432/ids_db

# --- Threat Detection Thresholds ---
# Distinct destination ports probed by single IP within TIME_WINDOW
PORT_SCAN_THRESHOLD=15

# SYN packets sent by single IP within TIME_WINDOW to a service port
SYN_FLOOD_THRESHOLD=100

# Sliding window duration in seconds for stateful rules
TIME_WINDOW=10

# --- Deep Packet Inspection (DPI) & DNS Security ---
# Enable regex-based payload inspection for SQLi, XSS, credential leakage
PAYLOAD_INSPECTION=true
# Maximum payload bytes scanned per packet (prevents CPU exhaustion)
PAYLOAD_MAX_BYTES=512

# Shannon entropy threshold for suspicious domain names (DGA/tunneling)
DNS_ENTROPY_THRESHOLD=3.8
# Maximum normal domain length before triggering length anomaly
DNS_QUERY_MAX_LEN=50

# --- Analysis & Aggregation ---
# Frequency (in seconds) for background analysis loop and threat evaluation
ANALYSIS_INTERVAL=30

# --- Dashboard Web UI ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false

# --- Data Retention & History ---
# Days of alert history to retain in the database (0 = keep indefinitely)
ALERT_RETENTION_DAYS=14
# Default time range displayed in the Dashboard History view (in days)
HISTORY_DAYS=7

# --- File Paths ---
# Local cache path for threat intelligence IP blocklist
BLOCKLIST_PATH=data/blocklist.txt
# Path for analyst feedback log (True Positive / False Positive classifications)
FEEDBACK_PATH=data/feedback.jsonl

