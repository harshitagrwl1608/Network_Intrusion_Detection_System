# =============================================================================
# NetGuard IDS — Git Ignore Rules
# =============================================================================

# --- Environment & Secrets (CRITICAL) ---
# Never commit credentials, connection strings, or local environment overrides
.env
.env.*
!.env.example

# --- Python Bytecode & Packaging ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Databases & Runtime Data (Private Network Telemetry) ---
*.db
*.sqlite
*.sqlite3
storage/*.db
alerts.db

# --- Dynamic State & Logs ---
# Runtime ARP table maps actual physical device MACs on the monitored network
data/arp_table.json
# Analyst alert feedback (contains private logged IP activity)
data/feedback.jsonl
# Background updater logs
data/blocklist_update.log
*.log

# --- Packet Capture Dumps ---
# Live PCAP captures can leak unencrypted credentials and private network traces.
*.pcap
*.pcapng
*.cap
# Whitelist synthetic unit test attack PCAP (safe, non-private sample):
!data/test_attacks.pcap

# --- Benchmark & Suricata Outputs ---
eve.json
suricata/
/tmp/suricata/
fast.log
stats.log

# --- IDEs and Text Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.directory

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
